# Copy to processes.env alongside this file. Used by docker-compose.yml (env_file).

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT=4600
PUBLIC_BASE_URL=https://api.voyagersearch.com/ospd
REGISTER_BASE_URL=https://api.voyagersearch.com/ospd/register

# ── Voyager HQ (containers reach the docker host as host.docker.internal) ────
HQ_BASE_URL=http://host.docker.internal:4000
HQ_USERNAME=admin
HQ_PASSWORD=
HQ_PROV_FILE_ROOT=py
HQ_PROV_SUBPATH=test_data/prov
HQ_PROV_CONCURRENCY=8

# ── Mastra RAG service ───────────────────────────────────────────────────────
RAG_BASE_URL=http://host.docker.internal:4500

# ── Optional toggle override (JSON literal) ──────────────────────────────────
# Example: {"generate":{"enabled":false}}
PROCESSES_TOGGLE_OVERRIDE=
