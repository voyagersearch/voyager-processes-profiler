# Copy to processes.env alongside this file. Used by docker-compose.yml (env_file).

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT=4601
# Ephemeral demo host by default. When you commit to the OSPD DNS name flip
# this to https://api.voyagersearch.com/ospd (Phase 5B).
PUBLIC_BASE_URL=http://ec2-18-224-65-160.us-east-2.compute.amazonaws.com:4601
REGISTER_BASE_URL=https://api.voyagersearch.com/ospd/register

# ── Voyager HQ (containers reach the docker host as host.docker.internal) ────
HQ_BASE_URL=http://host.docker.internal:4000
HQ_USERNAME=admin
HQ_PASSWORD=
HQ_PROV_FILE_ROOT=py
HQ_PROV_SUBPATH=test_data/prov
HQ_PROV_CONCURRENCY=8

# ── Mastra RAG service (docker-network hostname on the demo box) ─────────────
# Standard mode: reach RAG via host mapping (works if RAG publishes 4500).
#   RAG_BASE_URL=http://host.docker.internal:4500
# Demo mode: RAG runs on the voyager-rag-demo_default docker network with
# alias "rag". Use docker-compose.demo.yml so we join that network, then:
RAG_BASE_URL=http://rag:4500

# ── Rerank service (Cohere-shape /v1/rerank). Unset = score-sort fallback. ───
RANK_API_URL=
RANK_API_KEY=
RANK_MODEL=rerank-english-v3.0

# ── Optional toggle override (JSON literal) ──────────────────────────────────
# Example: {"generate":{"enabled":false}}
PROCESSES_TOGGLE_OVERRIDE=
