# voyager-processes-profiler — env template
# Copy to .env for local dev; copy deploy/processes.env.example for docker.

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT=4601
# The public URL this service is reached at. Used to mint absolute self-links
# in landing / process descriptions / job Locations.
PUBLIC_BASE_URL=http://localhost:4601
# The public URL the OSPD register (D110) is reached at. Used to render the
# "definitionUrl" link on each process description. Optional.
REGISTER_BASE_URL=https://api.voyagersearch.com/ospd/register

# ── Voyager HQ (for retrieve backing search + PROV sink) ─────────────────────
HQ_BASE_URL=http://localhost:4000
HQ_USERNAME=admin
HQ_PASSWORD=voyager
HQ_PROV_FILE_ROOT=py
HQ_PROV_SUBPATH=test_data/prov
HQ_PROV_CONCURRENCY=8

# ── Voyager Mastra RAG service (for generate proxy) ──────────────────────────
# Points at the running voyager-mastra-full-rag /ask endpoint. Leave blank
# to disable the generate process (503 returned).
RAG_BASE_URL=http://localhost:4500

# ── Rerank service (Cohere-shape /v1/rerank endpoint) ────────────────────────
# If set, the rank process POSTs candidates + query to {RANK_API_URL}/v1/rerank.
# Works with Cohere itself, Voyage AI, Jina, or any self-hosted bge-reranker-base
# behind a Cohere-compatible server. If unset, rank falls back to score-sort.
RANK_API_URL=
RANK_API_KEY=
RANK_MODEL=rerank-english-v3.0

# ── PROV activity-type register map (D110 URIs) ──────────────────────────────
# When set, D120's sidecar-writer maps process ids to canonical register URIs
# instead of the Voyager-internal namespace (https://voyager.ogc/prov/activity/).
# Matches voyager-prov-ts's PROV_REGISTER_MAP contract — same env var, same
# format, so operators can point both D100 and D120 at one register file.
#
# Accepts:
#   - a file path to a JSON object: PROV_REGISTER_MAP=/etc/voyager/prov-register.json
#   - an inline JSON literal:       PROV_REGISTER_MAP='{"geotag":"https://d110.ogc.org/registers/prov-activity/geotag"}'
#
# Missing entries fall back to https://voyager.ogc/prov/activity/{slug}.
PROV_REGISTER_MAP=

# ── Toggle overrides ─────────────────────────────────────────────────────────
# JSON literal, merged over src/processes/toggle.json. Optional.
# Example: {"retrieve":{"enabled":false}}
PROCESSES_TOGGLE_OVERRIDE=
