      "rdfs:label": "FAS Source Fetch",
      "dct:title": "FAS Source Fetch",
      "dct:description": "External catalog API pull. Retrieves source records from an authoritative external endpoint via a Voyager HQ Python connector, generating raw source records as the connector-chain start.",
      "rim:inRegister": {
        "@id": "http://ospd/demo/register/voyager-geoprocessing-activities"
      },
      "rim:itemClass": {
        "@id": "acttype:activityTypeItemClass"
