{
  "name": "voyager-processes-profiler",
  "version": "0.2.0",
  "private": true,
  "description": "Standalone OGC API-Processes 1.0 IPT-profile-conformant HTTP jacket over Voyager's activity chain. OSPD D120 deliverable.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bblocks:refresh": "node scripts/refresh-bblocks.mjs",
    "register:jsonld": "node scripts/generate-register-jsonld.mjs",
    "register:validate": "node scripts/validate-register-shacl.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "js-yaml": "^4.1.0",
    "voyager-prov-ts": "file:../voyager-prov-ts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
